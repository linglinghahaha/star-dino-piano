* text=auto

*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.webmanifest text eol=lf

# Approved runtime bitmaps are versioned through Git LFS.
assets/runtime/*.png filter=lfs diff=lfs merge=lfs -text
assets/runtime/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/runtime/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/runtime/*.webp filter=lfs diff=lfs merge=lfs -text
